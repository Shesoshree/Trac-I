# =====================================================================
# TRAC-I Phishing Intelligence & Threat Triage Engine - Environment Configuration
# =====================================================================

# Server Binding
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# Security & Rate Limiting
# Maximum analyze requests allowed per sliding 60-second window per client IP
MAX_REQUESTS_PER_MINUTE=30
SECRET_KEY=change-this-to-a-secure-random-token-in-production

# External Threat Intelligence APIs (Optional Fallback / Enterprise Augmentation)
# By default, Trac-I uses its built-in offline RDAP (RFC 7480) & WHOIS engine with SQLite caching.
# If you wish to route domain lookups through commercial threat feeds, provide your API key below:
# - WhoisXML API: https://whois.whoisxmlapi.com/ (Free tier: 500 queries/month)
WHOIS_API_KEY=

# Persistence
SQLITE_DB_PATH=data/scan_history.db
DOMAIN_CACHE_DB_PATH=data/domain_cache.db
